{
  "name": "vv-testlab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test && python -m unittest integration.test_bridge && vitest run",
    "test:core": "node --test",
