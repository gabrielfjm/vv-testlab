    "manuals:pdf": "python scripts/generate-manual-pdfs.py"
  },
  "devDependencies": {
    "happy-dom": "^20.14.0",
    "vite": "^7.1.4",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8"
  }
}
